---
import { getCollection, type CollectionEntry, z } from 'astro:content'
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import {
  Card,
  CardGrid,
  Icon,
  LinkButton,
} from '@astrojs/starlight/components'
import LanguageBadge from '../../../components/language-badge.astro'
import { languageNames, locales, type Locale, type ResourceContent } from '../../../content.config'

export async function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang }
  }))
}

const sortSchema = z.enum(['asc', 'desc'])
type SortOrder = z.infer<typeof sortSchema>

const { lang } = Astro.params

const url = Astro.url
const selectedType = url.searchParams.get('type') ?? ''
const selectedLanguage = url.searchParams.get('language') ?? (lang === 'en' ? '' : lang)
const sort = sortSchema.safeParse(url.searchParams.get('sort') ?? 'asc')
const selectedSort: SortOrder = sort.success ? sort.data : 'asc'

const isCriteriaSet = Boolean(selectedType || selectedLanguage)

const allResources = await getCollection('resources', (resource) => {
  return resource.data != null && resource.data.title != null
})

type Resource = CollectionEntry<'resources'> & {
  content: ResourceContent
  lang: Locale
}

let filteredItems: Resource[] = allResources
  .map((item) => {
    const [lang, id] = item.slug.split('/')

    return {
      ...item,
      content: item.data?.content?.at(0) as ResourceContent,
      lang: lang as Locale,
      id
    }
  })
  .filter((resource) => {
    const { lang, content } = resource

    if (selectedLanguage && lang !== selectedLanguage) {
      return false
    }

    if (selectedType && content?.type !== selectedType) {
      return false
    }

    return true
  }).sort((a, b) => {
    const titleA = a?.data?.title?.toLowerCase() ?? ''
    const titleB = b?.data?.title?.toLowerCase() ?? ''

    if (selectedSort === 'asc') {
      return titleA.localeCompare(titleB)
    } else {
      return titleB.localeCompare(titleA)
    }
  })

const pageProps = {
  frontmatter: {
    title: Astro.locals.t('resources.title'),
    description: Astro.locals.t('resources.description')
  },
  lang: lang
}
---

<StarlightPage {...pageProps}>
  <style>
    .filters-container {
      padding-left: 0.5rem;
      background: var(--sl-color-bg-nav);
      border-radius: 0.5rem;
      border: 1px solid var(--sl-color-hairline);
    }

    .filter-title {
      flex: 1;
    }

    .filter-summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
    }

    .sort-toggle-button {
      display: flex;
      align-items: center;
      gap: 0.25rem;
      margin: 0;
      border: 0;
      border-radius: 6px;
      background: var(--sl-color-bg-nav);
      color: var(--sl-color-text);
      cursor: pointer;
    }

    .filters-container summary {
      padding: 0.5rem;
      margin: 0;
    }

    .filters-container summary::before {
      color: var(--sl-icon-color);
    }

    .filters {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      padding-top: 0;
      padding-bottom: 1.5rem;
      padding-right: 1.5rem;
      align-items: end;
      margin-top: 0;
      margin-left: 0.5rem;
    }

    .filters label {
      display: flex;
      flex-direction: column;
      font-weight: 500;
      color: var(--sl-color-text);
      font-size: 0.9rem;
      min-width: 160px;
      flex: auto;
      margin-top: 0;
      margin-left: 0.5rem;
    }

    .filters select {
      padding: 0.5rem;
      margin-left: -0.5rem;
      border: 1px solid var(--sl-color-hairline);
      border-radius: 6px;
      background: var(--sl-color-bg);
      color: var(--sl-color-text);
      font-size: 0.9rem;
      cursor: pointer;
    }

    @media (max-width: 640px) {
      .filters {
        flex-direction: column;
        align-items: stretch;
      }
    }

    .empty-state {
      flex-direction: row;
      flex: content;
      text-align: center;
      align-self: center;
      justify-self: center;
      justify-items: center;
      padding: 2rem;
      color: var(--sl-color-text);
      font-size: 1.1rem;
    }
  </style>

  <script is:inline>
    window.toggleSort = function() {
      const currentSort = new URLSearchParams(window.location.search).get('sort') ?? 'asc'
      const newSort = currentSort === 'asc' ? 'desc' : 'asc'
      
      const url = new URL(window.location.href)
      url.searchParams.set('sort', newSort)
      
      window.location.href = url.toString()
    }
  </script>

  <p>{pageProps.frontmatter.description}</p>

  <form class="controls-container">
    <details class="filters-container">
      <summary class="filter-summary">
        <p class="filter-title">{Astro.locals.t('resources.filters.title')}</p>
        <button class="sort-toggle-button" type="button" onclick="toggleSort()">
          <span>{Astro.locals.t('resources.filters.sort.title')}</span>
          <Icon name={selectedSort === 'asc' ? 'down-arrow' : 'up-arrow'} />
        </button>
        <input type="hidden" name="sort" value={selectedSort} />
      </summary>

      <div class="filters">
        <label>
          {Astro.locals.t('resources.filters.resourceType')}
          <select name="type" onchange="this.form.submit()">
            <option value="" selected={selectedType === ''}>Any Type</option>
            <option value="document" selected={selectedType === 'document'}
              >Document</option
            >
            <option value="pdf" selected={selectedType === 'pdf'}
              >PDF File</option
            >
            <option value="video" selected={selectedType === 'video'}
              >Video</option
            >
            <option value="link" selected={selectedType === 'link'}
              >Website Link</option
            >
          </select>
        </label>

        <label>
          {Astro.locals.t('resources.filters.language')}
          <select name="language" onchange="this.form.submit()">
            <option value="" selected={selectedLanguage === ''}
              >Any Language</option
            >
            {
              locales.map((language) => (
                <option
                  value={language}
                  selected={selectedLanguage === language}
                >
                  {languageNames[language] ?? language}
                </option>
              ))
            }
          </select>
        </label>
      </div>
    </details>

    <noscript><button type="submit">Apply</button></noscript>
  </form>

  {
    filteredItems.length === 0 ? (
      <div class="empty-state">
        <Icon name="magnifier" size="2em" />
        {isCriteriaSet ? (
          <p>
            {Astro.locals.t('resources.emptyState.noResults')}
            <br />
            {Astro.locals.t('resources.emptyState.tryAdjustingFilters')}
          </p>
        ) : (
          <p>{Astro.locals.t('resources.emptyState.noResults')}</p>
        )}
      </div>
    ) : (
      <CardGrid>
        {filteredItems
        .map(({ id, data, content, lang }) => (
          <Card title={data?.title ?? ''}>
            {lang && <LanguageBadge lang={lang} />}
            {data?.summary && <p class="card-summary">{data.summary}</p>}

            <footer class="card-footer">
              <div class="card-actions" role="group" aria-label="Card actions">
                {content && content.type === 'video' && (
                  <LinkButton 
                    href={`/${lang}/resources/${id}`}
                    icon="seti:video"
                    iconPlacement="end"
                    variant="secondary"
                  >
                    {Astro.locals.t(`resources.card.file.view`)}
                  </LinkButton>
                )}

                {content && content.type === 'pdf' && (
                  <LinkButton
                    href={`/${lang}/resources/${id}`}
                    icon="seti:pdf"
                    iconPlacement="end"
                    variant="secondary"
                  >
                    {Astro.locals.t(`resources.card.file.view`)}
                  </LinkButton>
                
                  <LinkButton
                    href={`/${lang}/resources/${id}`}
                    download
                    icon="download"
                    iconPlacement="end"
                    variant="secondary"
                  >
                    {Astro.locals.t(`resources.card.file.download`)}
                  </LinkButton>
                )}

                {content && content.type === 'link' && (
                  <LinkButton
                    href={content.url}
                    icon="external"
                    iconPlacement="end"
                    variant="secondary"
                  >
                    {Astro.locals.t(`resources.card.url.goTo`)}
                  </LinkButton>
                )}

                {content && content.type === 'document' && (
                  <LinkButton
                    href={`/${lang}/resources/${id}`}
                    icon="document"
                    iconPlacement="end"
                    variant="secondary"
                  >
                    {Astro.locals.t(`resources.card.file.view`)}
                  </LinkButton>
                )}
              </div>
            </footer>
          </Card>
        ))}
      </CardGrid>
    )
  }
</StarlightPage>
