---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import { Icon } from '@astrojs/starlight/components'
import type { StarlightPageProps } from '@astrojs/starlight/props'
import { getCollection } from 'astro:content'
import type { TOptions } from 'i18next'
import { marked, type MarkedExtension } from 'marked'
import PdfPreview from '../../../../components/pdf-preview.astro'
import TopicBadge from '../../../../components/topic-badge.astro'
import { proficiencyLevelStyles } from '../../../../components/proficiency-level-styles'

interface Props {
  lang: string
  id: string
}

const { lang, id: resourceId } = Astro.params

const allResources = await getCollection('resources', (resource) => {
  return `${lang}/${resourceId}` === resource.slug
})

const resource = allResources.at(0)

const pageProps: StarlightPageProps = {
  frontmatter: {
    title: resource?.data?.title ?? Astro.locals.t('resource.notFound.title'),
    template: 'splash',
    prev: {
      link: `/${lang}/resources/`,
      label: Astro.locals.t('resources.title')
    }
  },
  lang: lang,
}

const content = resource?.data?.content?.at(0)
const proficiencyLevel = resource?.data?.level ?? 'beginner'
const breadcrumbsStyle = proficiencyLevelStyles[proficiencyLevel]

export const youtubeExtension: MarkedExtension = {
  extensions: [{
    name: 'youtube',
    level: 'block',
    start(src: string) {
      const m = src.match(/\{\{<\s*youtube\s+[A-Za-z0-9_-]{6,}\s*>\}\}/);
      return m ? m.index : undefined;
    },
    tokenizer(src: string) {
      const rule = /^\{\{<\s*youtube\s+([A-Za-z0-9_-]{6,})\s*>\}\}[ \t]*(?:\r?\n|$)/;
      const match = rule.exec(src);
      if (match) {
        const [, id] = match;
        return {
          type: 'youtube',
          raw: match[0],
          id,
        } as any;
      }
      return;
    },
    renderer(token: any) {
      const id = token.id as string;
      return (
        `<div class="yt-embed" data-youtube="${id}">` +
          `<iframe src="https://www.youtube.com/embed/${id}?si=sU5NH_DgVoueJa5g"` +
          ` title="YouTube video player"` +
          ` frameborder="0" ` +
          ` allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"` +
          ` referrerpolicy="strict-origin-when-cross-origin"` +
          ` allowfullscreen` +
          `></iframe>` +
        `</div>`
      );
    },
  }],
}

marked.use(youtubeExtension)

const markdown = content?.type === 'document' ? marked.parse(content?.body) : null

const notFoundSuggestion = Astro.locals.t('resource.notFound.suggestion', {
  link: `<a href="/${lang}/resources">${Astro.locals.t('resource.notFound.linkText')}</a>`,
  interpolation: { escapeValue: false }
} as TOptions)
---

<style 
  define:vars={{
    breadcrumbsColor: breadcrumbsStyle.darkColor,
  }}
>
  .resource-breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.75rem;
    color: var(--breadcrumbsColor);
    margin-bottom: 1.5rem;
  }
  
  .resource-breadcrumbs .breadcrumbs-icon {
    color: var(--breadcrumbsColor);
  }
</style>

<StarlightPage {...pageProps}>
  {(content == null) && (
    <p>
      {Astro.locals.t('resource.notFound.content')}
    </p>

    <p set:html={notFoundSuggestion} />
  )}

  <div class="resource-breadcrumbs">
    {resource?.data?.level && (
      <span>{Astro.locals.t(`resource.levels.${resource.data.level}`)}</span>
    )}

    {resource?.data?.type && (
      <>
        <Icon name="right-caret" size="1rem" class="breadcrumbs-icon" />
        <span>{Astro.locals.t(`resource.types.${resource.data.type}`)}</span>
      </>
    )}

    {resource?.data?.topics && resource.data.topics.length > 0 && (
      <>
        <Icon name="right-caret" size="1rem" class="breadcrumbs-icon"/>
        {resource.data.topics.map((topic) => (
          <TopicBadge topic={topic} size='small' />
        ))}
      </>
    )}
  </div>

  {content != null && content.type === 'document' && (
    <article set:html={markdown} />
  )}

  {content != null && content.type === 'pdf' && (
    <>
      {content.description && <p>{content.description}</p>}
      <PdfPreview
        pdfUrl={content.file}
        width="100%"
      />

    </>
  )}

  {content != null && content.type === 'video' && (
    <>
      {content.description && <p>{content.description}</p>}
      <video
        src={content.file}
        controls={true}
      />
    </>
  )}
</StarlightPage>
