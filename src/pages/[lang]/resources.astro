---
import { getCollection } from 'astro:content'
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'

export async function getStaticPaths() {
  const supportedLocales = ['en', 'es', 'fr', 'ar', 'sw', 'ht']
  return supportedLocales.map((lang) => ({
    params: { lang }
  }))
}

const { lang } = Astro.params

const url = Astro.url
const selectedProficiency = url.searchParams.get('proficiency') || ''
const selectedType = url.searchParams.get('type') || ''
const selectedTopic = url.searchParams.get('topic') || ''

const allResources = await getCollection('resources', (resource) => {
  return resource.data.lang == null || resource.data.lang === lang
})

let filteredItems = allResources.filter((resource) => {
  const data = resource.data

  if (selectedProficiency && data.proficiency !== selectedProficiency) {
    return false
  }

  if (selectedType && data.type !== selectedType) {
    return false
  }

  if (selectedTopic) {
    const resourceTopics = data.topics || []
    if (!resourceTopics.includes(selectedTopic)) {
      return false
    }
  }

  return true
})

const allTopics = [
  ...new Set(allResources.flatMap((resource) => resource.data.topics || []))
].sort()

const pageProps = {
  frontmatter: {
    title: 'Resources',
    description: 'Find ESL resources and local information in your language.'
  },
  lang: lang
}
---

<StarlightPage {...pageProps}>
  <style>
    .filters {
      background: var(--sl-color-bg-nav);
      padding: 1rem;
      border-radius: 0.5rem;
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      border: 1px solid var(--sl-color-hairline);
      align-items: end;
      margin-bottom: 2rem;
      margin-top: 0;
    }

    @media (max-width: 640px) {
      .filters {
        flex-direction: column;
        align-items: stretch;
      }
    }

    .filters label {
      display: flex;
      flex-direction: column;
      font-weight: 500;
      color: var(--sl-color-text);
      font-size: 0.9rem;
      min-width: 160px;
      flex: 1;
    }

    .filters select {
      padding: 0.5rem;
      border: 1px solid var(--sl-color-hairline);
      border-radius: 6px;
      background: var(--sl-color-bg);
      color: var(--sl-color-text);
      font-size: 0.9rem;
      cursor: pointer;
    }

    .resource-list {
      display: grid;
      gap: 1rem;
    }

    .resource-item {
      border: 1px solid var(--sl-color-hairline);
      border-radius: 8px;
      padding: 1.5rem;
      background: var(--sl-color-bg-nav);
    }

    .resource-item h3 {
      color: var(--sl-color-text);
    }

    .resource-meta {
      display: flex;
      gap: 1rem;
      font-size: 0.9rem;
      color: var(--sl-color-text);
    }

    .resource-link {
      display: inline-block;
      padding: 0.5rem 1rem;
      text-decoration: none;
      border-radius: 4px;
      font-weight: 500;
    }

    .resource-link:hover {
      opacity: 0.9;
    }

    .topics {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      margin: 0.5rem 0;
    }

    .topic-tag {
      background: color-mix(in srgb, var(--sl-color-accent) 30%, transparent);
      padding: 0.25rem 0.5rem;
      border-radius: 12px;
      font-size: 0.8rem;
    }
  </style>

  <form class="filters">
    <label>
      Topic
      <select name="topic" onchange="this.form.submit()">
        <option value="" selected={selectedTopic === ''}>Any Topic</option>
        {
          allTopics.map((topic) => (
            <option value={topic} selected={selectedTopic === topic}>
              {topic}
            </option>
          ))
        }
      </select>
    </label>
    <label>
      Proficiency Level
      <select name="proficiency" onchange="this.form.submit()">
        <option value="" selected={selectedProficiency === ''}>Any Level</option
        >
        <option value="beginner" selected={selectedProficiency === 'beginner'}
          >Beginner</option
        >
        <option
          value="intermediate"
          selected={selectedProficiency === 'intermediate'}>Intermediate</option
        >
        <option value="advanced" selected={selectedProficiency === 'advanced'}
          >Advanced</option
        >
      </select>
    </label>
    <label>
      Resource Type
      <select name="type" onchange="this.form.submit()">
        <option value="" selected={selectedType === ''}>Any Type</option>
        <option value="pdf" selected={selectedType === 'pdf'}
          >PDF Document</option
        >
        <option value="video" selected={selectedType === 'video'}>Video</option>
        <option value="link" selected={selectedType === 'link'}
          >Website Link</option
        >
      </select>
    </label>

    <noscript><button type="submit">Apply Filters</button></noscript>
  </form>

  <div class="resource-list">
    {
      filteredItems.length === 0 ? (
        <p>
          No resources found matching your criteria. Try adjusting the filters
          above.
        </p>
      ) : (
        filteredItems.map(({ id, data }) => (
          <article class="resource-item">
            <h3>{data.title}</h3>
            {data.description && <p>{data.description}</p>}

            <div class="resource-meta">
              {data.proficiency && (
                <strong>
                  {data.proficiency.charAt(0).toUpperCase() +
                    data.proficiency.slice(1)}
                </strong>
              )}
              {data.duration && (
                <>
                  <span>•</span>
                  <span>{data.duration}</span>
                </>
              )}
            </div>

            {data.topics && data.topics.length > 0 && (
              <div class="topics">
                {data.topics.map((topic) => (
                  <span class="topic-tag">{topic}</span>
                ))}
              </div>
            )}

            {data.source && (
              <p>
                <em>Source: {data.source}</em>
              </p>
            )}

            {data.type === 'pdf' && data.fileUrl && (
              <a href={data.fileUrl} download class="resource-link">
                📄 Download PDF
              </a>
            )}
            {data.type === 'video' && data.videoUrl && (
              <a
                href={data.videoUrl}
                target="_blank"
                rel="noopener"
                class="resource-link"
              >
                🎥 Watch Video
              </a>
            )}
            {data.type === 'link' && data.externalUrl && (
              <a
                href={data.externalUrl}
                target="_blank"
                rel="noopener"
                class="resource-link"
              >
                🔗 Open Link
              </a>
            )}
          </article>
        ))
      )
    }
  </div>
</StarlightPage>
