---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import type { StarlightPageProps } from '@astrojs/starlight/props'
import { getCollection } from 'astro:content'
import type { TOptions } from 'i18next'
import { marked, type MarkedExtension } from 'marked'

interface Props {
  lang: string
  id: string
}

const { lang, id: resourceId } = Astro.params

const allResources = await getCollection('esl-resources', (resource) => {
  return `${resourceId}` === resource.slug
})

const resource = allResources.at(0)

const pageProps: StarlightPageProps = {
  frontmatter: {
    title: resource?.data?.title ?? 'Resource Not Found',
    template: 'splash',
    prev: {
      link: `/${lang}/esl-resources/`,
      label: 'ESL Resources'
    }
  },
  lang: lang,
}

const content = resource?.data?.content?.at(0)

export const youtubeExtension: MarkedExtension = {
  extensions: [{
    name: 'youtube',
    level: 'block',
    start(src: string) {
      const m = src.match(/\{\{<\s*youtube\s+[A-Za-z0-9_-]{6,}\s*>\}\}/);
      return m ? m.index : undefined;
    },
    tokenizer(src: string) {
      const rule = /^\{\{<\s*youtube\s+([A-Za-z0-9_-]{6,})\s*>\}\}[ \t]*(?:\r?\n|$)/;
      const match = rule.exec(src);
      if (match) {
        const [, id] = match;
        return {
          type: 'youtube',
          raw: match[0],
          id,
        } as any;
      }
      return;
    },
    renderer(token: any) {
      const id = token.id as string;
      return (
        `<div class="yt-embed" data-youtube="${id}">` +
          `<iframe src="https://www.youtube.com/embed/${id}?si=sU5NH_DgVoueJa5g"` +
          ` title="YouTube video player"` +
          ` frameborder="0" ` +
          ` allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"` +
          ` referrerpolicy="strict-origin-when-cross-origin"` +
          ` allowfullscreen` +
          `></iframe>` +
        `</div>`
      );
    },
  }],
}

marked.use(youtubeExtension)

const markdown = content?.type === 'document' ? marked.parse(content?.body) : null
---

<StarlightPage {...pageProps}>
  {(content == null) && (
    <p>
      The resource you are looking for is not found. It may have been removed or the link is incorrect.
    </p>

    <p>Please check the URL or {<a href="/${lang}/esl-resources">return to the resources page</a>}.</p>
  )}

  {content != null && content.type === 'document' && (
    <article set:html={markdown} />
  )}

  {content != null && content.type === 'pdf' && (
    <>
      {content.description && <p>{content.description}</p>}
      <embed
        src={content.file}
        type="application/pdf"
        width="100%"
        height="800px"
      />
    </>
  )}

  {content != null && content.type === 'video' && (
    <>
      {content.description && <p>{content.description}</p>}
      <video
        src={content.file}
        controls={true}
      />
    </>
  )}
</StarlightPage>
