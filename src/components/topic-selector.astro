---
import TopicBadge from './topic-badge.astro'
import { type ResourceTopic } from '../content.config'

interface Props {
  allTopics: ResourceTopic[]
  selectedTopics: Set<ResourceTopic>
}

const { allTopics, selectedTopics } = Astro.props
---

<div class="topic-selector">
  <div class="topic-grid">
    {
      allTopics.map((topic) => (
        <label class="topic-option">
          <input
            type="checkbox"
            name="topic"
            value={topic}
            checked={selectedTopics.has(topic)}
          />
          <div class="topic-badge-wrapper">
            <TopicBadge topic={topic} />
          </div>
        </label>
      ))
    }
  </div>

  <style>
    .topic-selector {
      display: flex;
      flex-direction: row;
      gap: 1rem;
    }

    .topic-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      flex: 1;
    }

    .topic-option {
      position: relative;
      cursor: pointer;
      margin: 0;
    }

    .topic-option input[type='checkbox'] {
      position: absolute;
      opacity: 0;
      width: 0;
      height: 0;
    }

    .topic-badge-wrapper {
      transition: all 0.2s ease;
      border-radius: 0.5rem;
      position: relative;
      line-height: normal;
    }

    .topic-option:hover .topic-badge-wrapper {
      transform: translateY(-1px);
      box-shadow: 4px 4px 8px 4px rgba(0, 0, 0, 0.1);
    }

    .topic-option input[type='checkbox']:checked + .topic-badge-wrapper {
      transform: none;
      box-shadow: none;
    }

    .topic-option input[type='checkbox']:checked + .topic-badge-wrapper::after {
      content: '✓';
      position: absolute;
      top: -4px;
      right: -4px;
      background: var(--sl-color-accent);
      color: white;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: bold;
      border: 2px solid var(--sl-color-bg);
    }

    @media (max-width: 640px) {
      .topic-grid {
        justify-content: center;
      }
    }
  </style>
</div>
