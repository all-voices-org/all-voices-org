---
export interface Props {
  children: any
}

const { children } = Astro.props
---

<div class="cofounders-container">
  <slot />
</div>

<style>
  .cofounders-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
    justify-items: center;
    margin: 40px 0;
    width: 100%;
    max-width: 1000px;
    margin-left: auto;
    margin-right: auto;
  }

  .cofounders-container :global(.cofounder-card) {
    width: 100%;
    max-width: 450px;
  }

  @media (max-width: 768px) {
    .cofounders-container {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
