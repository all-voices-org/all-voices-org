---
export interface Props {
  name: string
  imageUrl: string
  altText: string
  bio: string
  languages: string
}

const { name, imageUrl, altText, bio, languages } = Astro.props
---

<div class="cofounder-card">
  <img src={imageUrl} alt={altText} class="profile-image" />
  <h3>{name}</h3>
  <p class="bio">{bio}</p>
  <p class="languages">
    <strong>{Astro.locals.t('ui.languages')}:</strong>
    {languages}
  </p>
</div>

<style>
  .cofounder-card {
    margin: 0;
    background: var(--sl-color-bg-card);
    border-radius: 16px;
    padding: 30px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    border: 1px solid var(--sl-color-hairline-light);
    flex: 1;
    flex-direction: column;
    align-items: center;
    min-width: 300px;
    max-width: 450px;
    text-align: center;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .profile-image {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 20px;
    border: 1px solid var(--sl-color-hairline-light);
  }

  h3 {
    margin: 0 0 0.5rem 0;
    color: var(--sl-color-white);
    font-size: 1.3em;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .bio {
    color: var(--sl-color-text);
    line-height: 1.6;
    margin-bottom: auto;
    flex-grow: 1;
    font-size: 0.9em;
    text-align: left;
    padding: 0 10px;
    hyphens: auto;
    text-justify: inter-word;
  }

  .languages {
    color: var(--sl-color-text-accent);
    font-style: italic;
    margin: 18px -10px 0 -10px;
    font-size: 0.85em;
    font-weight: 500;
    padding: 12px 10px 0 10px;
    border-top: 1px solid var(--sl-color-hairline);
    position: relative;
    width: 100%;
  }

  .languages::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--sl-color-hairline);
  }
</style>
