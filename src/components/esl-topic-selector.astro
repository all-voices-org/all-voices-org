---
import { type EslResourceTopic } from '../content.config'
import EslTopicBadge from './esl-topic-badge.astro'

interface Props {
  allTopics: EslResourceTopic[]
  selectedTopics: Set<EslResourceTopic>
}

const { allTopics, selectedTopics } = Astro.props
---

<div class="topic-selector">
  <div class="topic-grid">
    {
      allTopics.map((topic) => (
        <label class="topic-option">
          <input
            type="checkbox"
            name="topic"
            value={topic}
            checked={selectedTopics.has(topic)}
          />
          <div class="topic-badge-wrapper">
            <EslTopicBadge topic={topic} />
          </div>
        </label>
      ))
    }
  </div>
</div>
